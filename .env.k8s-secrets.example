# Copy to .env.k8s-secrets, fill in real values (same values as your .env),
# never commit it. Loads into the cluster via:
#   kubectl create secret generic lifeos-secrets -n lifeos --from-env-file=.env.k8s-secrets
#
# Only credential-bearing values live here — everything else is in
# deploy/lifeos/values.yaml's `config:` block (plain ConfigMap data).
# See deploy/README.md.

# --- Postgres ---
POSTGRES_USER=lifeos
POSTGRES_PASSWORD=
POSTGRES_DB=lifeos
# Must embed the same password as above — app/config.py reads this as one
# field, not assembled from the individual POSTGRES_* vars.
DATABASE_URL=postgresql+psycopg://lifeos:REPLACE_WITH_POSTGRES_PASSWORD@postgres:5432/lifeos

# --- Telegram ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USER_ID=

# --- Cloud LLM ---
OPENROUTER_API_KEY=

# --- Google Maps ---
GOOGLE_MAPS_API_KEY=

# --- Google Calendar ---
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=
GOOGLE_CALENDAR_REFRESH_TOKEN=

# --- Apple Health sync ---
HEALTH_SYNC_TOKEN=

# --- Web app login ---
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
WEBAPP_SECRET_KEY=

# --- Phase 3 (n8n + ngrok) — leave blank for now, filled in when those are migrated ---
N8N_BASIC_AUTH_PASSWORD=
NGROK_AUTHTOKEN=
NGROK_STATIC_DOMAIN=
